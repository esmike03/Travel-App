{
  "expo": {
    "name": "Chirpy - Your Travel Companion",
    "slug": "travs-bohol",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "chirpy",
    "icon": "./assets/branding/chirpy-app-icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chirpy.travel",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Chirpy uses your location to show nearby destinations, distance, and travel times."
      }
    },
    "android": {
      "package": "com.chirpy.travel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/chirpy-adaptive-icon.png",
        "backgroundColor": "#FFF8E8"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chirpy uses your location to show nearby destinations, distance, and travel times."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chirpy lets you add one of your own photos to a trip card.",
          "cameraPermission": "Chirpy lets you take a photo for a trip card."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Chirpy saves your shareable trip card to your photos.",
          "savePhotosPermission": "Chirpy saves your shareable trip card to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/chirpy-walking.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8E8"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/branding/chirpy-app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3df0fd39-b724-4c44-acdc-5d33c2feb5a7"
      }
    }
  }
}
